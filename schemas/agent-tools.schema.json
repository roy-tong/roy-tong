{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/roy-tong/roy-tong/main/schemas/agent-tools.schema.json",
  "title": "Roy Tong Agent Tool Catalog",
  "description": "A versioned, machine-readable routing contract for Roy Tong's public Agent Skills and local-first research tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "catalog_url",
    "purpose",
    "router",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "1.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "catalog_url": {
      "type": "string",
      "format": "uri"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "router": {
      "$ref": "#/$defs/router"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "preview_command",
        "install_command",
        "invoke_example"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "preview_command": {
          "type": "string",
          "minLength": 1
        },
        "install_command": {
          "type": "string",
          "minLength": 1
        },
        "invoke_example": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "agent-skill",
            "local-cli",
            "validator",
            "web-index"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "preview_command",
        "install_command"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "preview_command": {
          "type": "string",
          "minLength": 1
        },
        "install_command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "first_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "success"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "brand",
        "summary",
        "match",
        "avoid",
        "repository",
        "status",
        "surfaces",
        "skill",
        "input",
        "output",
        "invoke_example",
        "first_success",
        "constraints",
        "privacy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 20
        },
        "match": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "avoid": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/roy-tong/[A-Za-z0-9._-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "public",
            "public-beta",
            "public-read-only"
          ]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "skill": {
          "$ref": "#/$defs/skill"
        },
        "input": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "output": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "invoke_example": {
          "type": "string",
          "minLength": 1
        },
        "first_success": {
          "$ref": "#/$defs/first_success"
        },
        "constraints": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "privacy": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
